+def test_third_renew_is_rejected():
+    # B1 反例：已续借 2 次，第 3 次必须被拒，到期日和次数都不变
+    store = make_store()
+    renew(store, 1, today=date(2026, 11, 20))
+    renew(store, 1, today=date(2026, 11, 21))
+    try:
+        renew(store, 1, today=date(2026, 11, 22))
+    except RenewLimitError:
+        pass
+    else:
+        raise AssertionError("第 3 次续借应被拒绝")
+    loan = store.get(1)
+    assert loan.renew_count == 2
+    assert loan.due == date(2026, 12, 29)
+
+
+def test_overdue_renew_does_not_consume_count():
+    # B2 反例：逾期续借被拒，续借次数和到期日都不变
+    store = make_store()
+    try:
+        renew(store, 1, today=date(2026, 12, 20))
+    except OverdueError:
+        pass
+    else:
+        raise AssertionError("逾期续借应被拒绝")
+    loan = store.get(1)
+    assert loan.renew_count == 0
+    assert loan.due == date(2026, 12, 1)
+
+
