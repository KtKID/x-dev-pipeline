+def test_third_renewal_is_rejected():
+    # B1 反例：MAX_RENEWALS=2，第 3 次续借必须被拒绝，到期日和次数都不变
+    store = make_store()
+    renew(store, 1, today=date(2026, 11, 20))
+    renew(store, 1, today=date(2026, 11, 20))
+    due_before = store.get(1).due
+    with pytest.raises(RenewLimitError):
+        renew(store, 1, today=date(2026, 11, 20))
+    loan = store.get(1)
+    assert loan.renew_count == 2
+    assert loan.due == due_before
+
+
+def test_overdue_renewal_does_not_consume_count():
+    # B2 反例：逾期续借被拒绝后，续借次数和到期日都不变
+    store = LoanStore([Loan(2, member_id=20, book="活着", due=date(2026, 11, 1))])
+    with pytest.raises(OverdueError):
+        renew(store, 2, today=date(2026, 11, 20))
+    loan = store.get(2)
+    assert loan.renew_count == 0
+    assert loan.due == date(2026, 11, 1)
+
+
